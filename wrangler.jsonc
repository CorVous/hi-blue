{
	"name": "hi-blue-proxy",
	"main": "src/proxy/worker.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"build": {
		"command": "pnpm build",
		"watch_dir": "src/spa"
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"kv_namespaces": [
		{
			"binding": "RATE_GUARD_KV",
			"id": "95ce5559c2894b1eb6bb95c25897a0c3",
			"remote": true
		}
	],
	"vars": {
		"PER_IP_DAILY_MICRO_USD_MAX": "1000000",
		"GLOBAL_DAILY_MICRO_USD_MAX": "10000000",
		"PRE_CHARGE_MICRO_USD": "5000",
		"ALLOWED_ORIGINS": "https://hi-blue.cor.gg"
	}
}
